  <!-- 编译后把 exe 补齐到正好 666 KB（681984 字节）。
       零字节追加在 PE 尾部，加载器按 section 表映射，不影响运行。
       已经超过 666 KB 时跳过，不做截断。 -->
  <Target Name="PadTo666KB" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$f='$(TargetPath)'; if (Test-Path $f) { $t=666*1024; $c=(Get-Item $f).Length; if ($c -lt $t) { $b=New-Object byte[] ($t-$c); $s=[System.IO.File]::Open($f,[System.IO.FileMode]::Append); $s.Write($b,0,$b.Length); $s.Close(); Write-Host ('[666KB] padded ' + ($t-$c) + ' bytes') } else { Write-Host ('[666KB] skip, size=' + $c) } }&quot;" />
  </Target>
