        private void button1_Click(object sender, EventArgs e)
        {
            string filePath = @".\\Date\\DateBase.config";
            if (File.Exists(@".\\Date\\DateBase.config"))
            {
                ExeConfigurationFileMap exeConfigurationFileMap;
                Configuration configuration;
                exeConfigurationFileMap = new ExeConfigurationFileMap();
                exeConfigurationFileMap.ExeConfigFilename = filePath;
                configuration = ConfigurationManager.OpenMappedExeConfiguration(exeConfigurationFileMap, ConfigurationUserLevel.None);
                string Name = configuration.AppSettings.Settings["UserName"].Value;
                string Password = configuration.AppSettings.Settings["PassWord"].Value;
                ///
                byte[] result = Encoding.Default.GetBytes(this.textBox1.Text.Trim());
                MD5 md5name = new MD5CryptoServiceProvider();
                byte[] nameoutput = md5name.ComputeHash(result);
                string name = BitConverter.ToString(nameoutput).Replace("-", "");
                ///将textBox1的数据MD5加密并存入name中
                byte[] result2 = Encoding.Default.GetBytes(this.textBox2.Text.Trim());
                MD5 md5password = new MD5CryptoServiceProvider();
                byte[] passwordoutput = md5password.ComputeHash(result2);
                string password = BitConverter.ToString(passwordoutput).Replace("-", "");
                ///将textBox2的数据MD5加密并存入password中
                if (Name == null || Password == null || name== null || password== null)
                {
                    MessageBox.Show("File read error!", "ERROR!", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    Kill("windowsprocesscheck");
                    Kill("windowsprocesscheckbeta");
                    Application.Exit();
                }
                else
                {
                    if (name == Name && password == Password)//验证密码
                    {
                        Main main = new Main();
                        this.Hide();
                        main.Show();
                    }
                    else
                    {
                        MessageBox.Show("Wrong username or wrong password!", "ERROR!", MessageBoxButtons.OK, MessageBoxIcon.Error);
                        return;
                    }
                }
            }
            else
